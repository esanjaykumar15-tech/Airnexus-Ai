# AIRNEXUS AI — Environment Variables
#
# The app runs in DEMO MODE with zero configuration — every variable
# below is optional. Setting AIR_QUALITY_API_KEY switches the data
# layer to LIVE MODE (once you wire a real provider into lib/demoData.ts).

# Database (for future LIVE MODE persistence — not required for demo mode)
DATABASE_URL=

# Live data providers (optional — demo mode is used until these are set)
AIR_QUALITY_API_KEY=
WEATHER_API_KEY=
TRAFFIC_API_KEY=
FIRE_API_KEY=
MAP_API_KEY=

# AI Assistant — if unset, /api/ai/chat uses the rule-based fallback assistant
LLM_API_KEY=
